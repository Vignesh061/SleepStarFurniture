rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Sleep Star Furniture Storage Rules
    // Public read for website catalogue; authenticated upload for admin management

    function isAuthenticated() {
      return request.auth != null;
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
